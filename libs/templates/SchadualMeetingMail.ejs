<!DOCTYPE html>
<html
  lang="en"
  xmlns="http://www.w3.org/1999/xhtml"
  xmlns:v="urn:schemas-microsoft-com:vml"
  xmlns:o="urn:schemas-microsoft-com:office:office"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>New Meeting Request</title>
    <!--[if mso]>
      <noscript>
        <xml>
          <o:OfficeDocumentSettings>
            <o:PixelsPerInch>96</o:PixelsPerInch>
          </o:OfficeDocumentSettings>
        </xml>
      </noscript>
      <style>
        table {
          border-collapse: collapse;
        }
      </style>
    <![endif]-->
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #ffffff;
      -webkit-text-size-adjust: 100%;
      -ms-text-size-adjust: 100%;
    "
  >
    <!-- Preheader (hidden preview text) -->
    <div style="display: none; max-height: 0; overflow: hidden; opacity: 0; mso-hide: all">
      A new visitor has scheduled a meeting through the IBRAS Aviation
      website.&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;
    </div>

    <table
      role="presentation"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      style="background-color: #ffffff; width: 100%"
    >
      <tr>
        <td align="center" style="padding: 32px 16px">
          <table
            role="presentation"
            width="620"
            cellpadding="0"
            cellspacing="0"
            border="0"
            style="width: 620px; max-width: 620px"
          >
            <!-- ===================== HEADER ===================== -->
            <tr>
              <td
                style="
                  background-color: #0b1630;
                  background: linear-gradient(135deg, #0b1630 0%, #133a7c 55%, #1f4e9a 100%);
                  border-radius: 16px 16px 0 0;
                  padding: 44px 40px 38px 40px;
                  border: 1px solid #23365d;
                  border-bottom: none;
                "
              >
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td align="center" style="padding-bottom: 14px">
                      <span
                        style="
                          display: inline-block;
                          padding: 6px 16px;
                          border: 1px solid rgba(165, 175, 189, 0.4);
                          border-radius: 20px;
                          font-family: Arial, Helvetica, sans-serif;
                          font-size: 11px;
                          letter-spacing: 2.5px;
                          color: #c3cbd6;
                          text-transform: uppercase;
                        "
                        >IBRAS Aviation</span
                      >
                    </td>
                  </tr>
                  <tr>
                    <td align="center">
                      <h1
                        style="
                          margin: 0;
                          font-family: Arial, Helvetica, sans-serif;
                          font-size: 28px;
                          line-height: 36px;
                          font-weight: bold;
                          color: #ffffff;
                          letter-spacing: 0.3px;
                        "
                      >
                        New Meeting Booking
                      </h1>
                    </td>
                  </tr>
                  <tr>
                    <td align="center" style="padding-top: 12px">
                      <p
                        style="
                          margin: 0;
                          font-family: Arial, Helvetica, sans-serif;
                          font-size: 14px;
                          line-height: 22px;
                          color: #c8d1de;
                          max-width: 440px;
                        "
                      >
                        A new visitor has scheduled a meeting through the IBRAS Aviation website.
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- ===================== BODY WRAPPER ===================== -->
            <tr>
              <td
                style="
                  background-color: #0b1630;
                  border: 1px solid #23365d;
                  border-top: none;
                  border-bottom: none;
                  padding: 36px 40px 8px 40px;
                "
              >
                <!-- Section label -->
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td style="padding-bottom: 16px">
                      <span
                        style="
                          font-family: Arial, Helvetica, sans-serif;
                          font-size: 11px;
                          letter-spacing: 2px;
                          color: #5d84d6;
                          text-transform: uppercase;
                          font-weight: bold;
                        "
                        >Visitor Information</span
                      >
                    </td>
                  </tr>
                </table>

                <!-- ===================== INFO CARD ===================== -->
                <table
                  role="presentation"
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="background-color: #0f1c3f; border: 1px solid #23365d; border-radius: 14px"
                >
                  <tr>
                    <td style="padding: 6px 28px">
                      <!-- Row: First Name -->
                      <table
                        role="presentation"
                        width="100%"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                        style="border-bottom: 1px solid #23365d"
                      >
                        <tr>
                          <td
                            width="42%"
                            style="
                              padding: 16px 12px 16px 0;
                              font-family: Arial, Helvetica, sans-serif;
                              font-size: 13px;
                              color: #a5afbd;
                              letter-spacing: 0.3px;
                              vertical-align: middle;
                            "
                          >
                            <!--[if !mso]><!-->
                            <svg
                              width="14"
                              height="14"
                              viewBox="0 0 24 24"
                              fill="none"
                              xmlns="http://www.w3.org/2000/svg"
                              style="vertical-align: -2px; margin-right: 6px"
                            >
                              <path
                                d="M12 12C14.7614 12 17 9.76142 17 7C17 4.23858 14.7614 2 12 2C9.23858 2 7 4.23858 7 7C7 9.76142 9.23858 12 12 12Z"
                                fill="#5D84D6"
                              />
                              <path
                                d="M12 14C7.58172 14 4 16.6863 4 20V21C4 21.5523 4.44772 22 5 22H19C19.5523 22 20 21.5523 20 21V20C20 16.6863 16.4183 14 12 14Z"
                                fill="#5D84D6"
                              />
                            </svg>
                            <!--<![endif]-->
                            First Name
                          </td>
                          <td
                            width="58%"
                            align="right"
                            style="
                              padding: 16px 0 16px 12px;
                              font-family: Arial, Helvetica, sans-serif;
                              font-size: 15px;
                              color: #ffffff;
                              font-weight: bold;
                              vertical-align: top;
                              text-align: right;
                            "
                          >
                            <%= firstName %>
                          </td>
                        </tr>
                      </table>

                      <!-- Row: Last Name -->
                      <table
                        role="presentation"
                        width="100%"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                        style="border-bottom: 1px solid #23365d"
                      >
                        <tr>
                          <td
                            width="42%"
                            style="
                              padding: 16px 12px 16px 0;
                              font-family: Arial, Helvetica, sans-serif;
                              font-size: 13px;
                              color: #a5afbd;
                              letter-spacing: 0.3px;
                              vertical-align: middle;
                            "
                          >
                            <!--[if !mso]><!-->
                            <svg
                              width="14"
                              height="14"
                              viewBox="0 0 24 24"
                              fill="none"
                              xmlns="http://www.w3.org/2000/svg"
                              style="vertical-align: -2px; margin-right: 6px"
                            >
                              <path
                                d="M12 12C14.7614 12 17 9.76142 17 7C17 4.23858 14.7614 2 12 2C9.23858 2 7 4.23858 7 7C7 9.76142 9.23858 12 12 12Z"
                                fill="#5D84D6"
                              />
                              <path
                                d="M12 14C7.58172 14 4 16.6863 4 20V21C4 21.5523 4.44772 22 5 22H19C19.5523 22 20 21.5523 20 21V20C20 16.6863 16.4183 14 12 14Z"
                                fill="#5D84D6"
                              />
                            </svg>
                            <!--<![endif]-->
                            Last Name
                          </td>
                          <td
                            width="58%"
                            align="right"
                            style="
                              padding: 16px 0 16px 12px;
                              font-family: Arial, Helvetica, sans-serif;
                              font-size: 15px;
                              color: #ffffff;
                              font-weight: bold;
                              vertical-align: top;
                              text-align: right;
                            "
                          >
                            <%= lastName %>
                          </td>
                        </tr>
                      </table>

                      <!-- Row: Email -->
                      <table
                        role="presentation"
                        width="100%"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                        style="border-bottom: 1px solid #23365d"
                      >
                        <tr>
                          <td
                            width="42%"
                            style="
                              padding: 16px 12px 16px 0;
                              font-family: Arial, Helvetica, sans-serif;
                              font-size: 13px;
                              color: #a5afbd;
                              letter-spacing: 0.3px;
                              vertical-align: middle;
                            "
                          >
                            <!--[if !mso]><!-->
                            <svg
                              width="14"
                              height="14"
                              viewBox="0 0 24 24"
                              fill="none"
                              xmlns="http://www.w3.org/2000/svg"
                              style="vertical-align: -2px; margin-right: 6px"
                            >
                              <path
                                d="M4 4H20C21.1 4 22 4.9 22 6V18C22 19.1 21.1 20 20 20H4C2.9 20 2 19.1 2 18V6C2 4.9 2.9 4 4 4Z"
                                stroke="#5D84D6"
                                stroke-width="1.6"
                              />
                              <path
                                d="M2 6L12 13L22 6"
                                stroke="#5D84D6"
                                stroke-width="1.6"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                              />
                            </svg>
                            <!--<![endif]-->
                            Email
                          </td>
                          <td
                            width="58%"
                            align="right"
                            style="
                              padding: 16px 0 16px 12px;
                              font-family: Arial, Helvetica, sans-serif;
                              font-size: 15px;
                              color: #ffffff;
                              font-weight: bold;
                              vertical-align: top;
                              text-align: right;
                              word-break: break-all;
                            "
                          >
                            <a
                              href="mailto:<%= email %>"
                              style="color: #ffffff; text-decoration: none"
                              ><%= email %></a
                            >
                          </td>
                        </tr>
                      </table>

                      <!-- Row: Phone -->
                      <table
                        role="presentation"
                        width="100%"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                        style="border-bottom: 1px solid #23365d"
                      >
                        <tr>
                          <td
                            width="42%"
                            style="
                              padding: 16px 12px 16px 0;
                              font-family: Arial, Helvetica, sans-serif;
                              font-size: 13px;
                              color: #a5afbd;
                              letter-spacing: 0.3px;
                              vertical-align: middle;
                            "
                          >
                            <!--[if !mso]><!-->
                            <svg
                              width="14"
                              height="14"
                              viewBox="0 0 24 24"
                              fill="none"
                              xmlns="http://www.w3.org/2000/svg"
                              style="vertical-align: -2px; margin-right: 6px"
                            >
                              <path
                                d="M6.6 10.8C7.9 13.4 10 15.5 12.6 16.8L14.6 14.8C14.9 14.5 15.3 14.4 15.7 14.6C16.9 15 18.2 15.2 19.5 15.2C20.1 15.2 20.5 15.6 20.5 16.2V19.7C20.5 20.3 20.1 20.7 19.5 20.7C10.4 20.7 3 13.3 3 4.2C3 3.6 3.4 3.2 4 3.2H7.5C8.1 3.2 8.5 3.6 8.5 4.2C8.5 5.5 8.7 6.8 9.1 8C9.2 8.4 9.1 8.8 8.8 9.1L6.6 10.8Z"
                                fill="#5D84D6"
                              />
                            </svg>
                            <!--<![endif]-->
                            Phone
                          </td>
                          <td
                            width="58%"
                            align="right"
                            style="
                              padding: 16px 0 16px 12px;
                              font-family: Arial, Helvetica, sans-serif;
                              font-size: 15px;
                              color: #ffffff;
                              font-weight: bold;
                              vertical-align: top;
                              text-align: right;
                            "
                          >
                            <a href="tel:<%= phone %>" style="color: #ffffff; text-decoration: none"
                              ><%= phone %></a
                            >
                          </td>
                        </tr>
                      </table>

                      <!-- Row: Meeting Date -->
                      <table
                        role="presentation"
                        width="100%"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                        style="border-bottom: 1px solid #23365d"
                      >
                        <tr>
                          <td
                            width="42%"
                            style="
                              padding: 16px 12px 16px 0;
                              font-family: Arial, Helvetica, sans-serif;
                              font-size: 13px;
                              color: #a5afbd;
                              letter-spacing: 0.3px;
                              vertical-align: middle;
                            "
                          >
                            <!--[if !mso]><!-->
                            <svg
                              width="14"
                              height="14"
                              viewBox="0 0 24 24"
                              fill="none"
                              xmlns="http://www.w3.org/2000/svg"
                              style="vertical-align: -2px; margin-right: 6px"
                            >
                              <rect
                                x="3"
                                y="4.5"
                                width="18"
                                height="16"
                                rx="2"
                                stroke="#5D84D6"
                                stroke-width="1.6"
                              />
                              <path d="M3 9.5H21" stroke="#5D84D6" stroke-width="1.6" />
                              <path
                                d="M8 2.5V6.5"
                                stroke="#5D84D6"
                                stroke-width="1.6"
                                stroke-linecap="round"
                              />
                              <path
                                d="M16 2.5V6.5"
                                stroke="#5D84D6"
                                stroke-width="1.6"
                                stroke-linecap="round"
                              />
                            </svg>
                            <!--<![endif]-->
                            Meeting Date
                          </td>
                          <td
                            width="58%"
                            align="right"
                            style="
                              padding: 16px 0 16px 12px;
                              font-family: Arial, Helvetica, sans-serif;
                              font-size: 15px;
                              color: #ffffff;
                              font-weight: bold;
                              vertical-align: top;
                              text-align: right;
                            "
                          >
                            <%= selectedDate %>
                          </td>
                        </tr>
                      </table>

                      <!-- Row: Meeting Time -->
                      <table
                        role="presentation"
                        width="100%"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                      >
                        <tr>
                          <td
                            width="42%"
                            style="
                              padding: 16px 12px 16px 0;
                              font-family: Arial, Helvetica, sans-serif;
                              font-size: 13px;
                              color: #a5afbd;
                              letter-spacing: 0.3px;
                              vertical-align: middle;
                            "
                          >
                            <!--[if !mso]><!-->
                            <svg
                              width="14"
                              height="14"
                              viewBox="0 0 24 24"
                              fill="none"
                              xmlns="http://www.w3.org/2000/svg"
                              style="vertical-align: -2px; margin-right: 6px"
                            >
                              <circle cx="12" cy="12" r="9" stroke="#5D84D6" stroke-width="1.6" />
                              <path
                                d="M12 7V12L15.5 14"
                                stroke="#5D84D6"
                                stroke-width="1.6"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                              />
                            </svg>
                            <!--<![endif]-->
                            Meeting Time
                          </td>
                          <td
                            width="58%"
                            align="right"
                            style="
                              padding: 16px 0 16px 12px;
                              font-family: Arial, Helvetica, sans-serif;
                              font-size: 15px;
                              color: #ffffff;
                              font-weight: bold;
                              vertical-align: top;
                              text-align: right;
                            "
                          >
                            <%= selectedTime %>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>
                <!-- ===================== END INFO CARD ===================== -->

                <!-- ===================== ADMIN REMINDER BOX ===================== -->
                <table
                  role="presentation"
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="
                    margin-top: 28px;
                    background-color: #0e1e3c;
                    border: 1px solid #1f4e9a;
                    border-left: 4px solid #5d84d6;
                    border-radius: 12px;
                  "
                >
                  <tr>
                    <td style="padding: 22px 26px">
                      <table
                        role="presentation"
                        width="100%"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                      >
                        <tr>
                          <td style="padding-bottom: 8px">
                            <!--[if !mso]><!-->
                            <svg
                              width="15"
                              height="15"
                              viewBox="0 0 24 24"
                              fill="none"
                              xmlns="http://www.w3.org/2000/svg"
                              style="vertical-align: -3px; margin-right: 7px"
                            >
                              <path
                                d="M12 22C13.1 22 14 21.1 14 20H10C10 21.1 10.9 22 12 22Z"
                                fill="#5D84D6"
                              />
                              <path
                                d="M18 16V11C18 7.9 16.4 5.4 13.5 4.7V4C13.5 3.2 12.8 2.5 12 2.5C11.2 2.5 10.5 3.2 10.5 4V4.7C7.6 5.4 6 7.9 6 11V16L4 18V19H20V18L18 16Z"
                                fill="#5D84D6"
                              />
                            </svg>
                            <!--<![endif]-->
                            <span
                              style="
                                font-family: Arial, Helvetica, sans-serif;
                                font-size: 13px;
                                letter-spacing: 1.5px;
                                color: #c3cbd6;
                                text-transform: uppercase;
                                font-weight: bold;
                                vertical-align: middle;
                              "
                              >Admin Reminder</span
                            >
                          </td>
                        </tr>
                        <tr>
                          <td>
                            <p
                              style="
                                margin: 0;
                                font-family: Arial, Helvetica, sans-serif;
                                font-size: 14px;
                                line-height: 22px;
                                color: #c8d1de;
                              "
                            >
                              Please contact this visitor as soon as possible to confirm the booking
                              and answer any questions they may have regarding their aviation
                              training or facility tour.
                            </p>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>
                <!-- ===================== END ADMIN REMINDER BOX ===================== -->

                <!-- ===================== ACTION BUTTON ===================== -->
                <table
                  role="presentation"
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="margin-top: 34px"
                >
                  <tr>
                    <td align="center">
                      <!--[if mso]>
                        <v:roundrect
                          xmlns:v="urn:schemas-microsoft-com:vml"
                          xmlns:w="urn:schemas-microsoft-com:office:word"
                          href="mailto:<%= email %>"
                          style="height: 50px; v-text-anchor: middle; width: 280px"
                          arcsize="12%"
                          strokecolor="#133A7C"
                          fillcolor="#133A7C"
                        >
                          <w:anchorlock />
                          <center
                            style="
                              color: #ffffff;
                              font-family: Arial, sans-serif;
                              font-size: 15px;
                              font-weight: bold;
                            "
                          >
                            Reply to Customer
                          </center>
                        </v:roundrect>
                      <![endif]-->
                      <!--[if !mso]><!-->
                      <a
                        href="mailto:<%= email %>"
                        style="
                          display: inline-block;
                          background-color: #133a7c;
                          color: #ffffff;
                          font-family: Arial, Helvetica, sans-serif;
                          font-size: 15px;
                          font-weight: bold;
                          text-decoration: none;
                          padding: 16px 40px;
                          border-radius: 10px;
                          letter-spacing: 0.3px;
                          border: 1px solid #1f4e9a;
                        "
                      >
                        <svg
                          width="15"
                          height="15"
                          viewBox="0 0 24 24"
                          fill="none"
                          xmlns="http://www.w3.org/2000/svg"
                          style="vertical-align: -2px; margin-right: 8px"
                        >
                          <path d="M2 3L22 12L2 21L2 14L16 12L2 10L2 3Z" fill="#FFFFFF" />
                        </svg>
                        Reply to Customer
                      </a>
                      <!--<![endif]-->
                    </td>
                  </tr>
                </table>
                <!-- ===================== END ACTION BUTTON ===================== -->

                <!-- Spacer -->
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td style="height: 36px; line-height: 36px; font-size: 1px">&nbsp;</td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- ===================== DIVIDER ===================== -->
            <tr>
              <td
                style="
                  background-color: #0b1630;
                  border-left: 1px solid #23365d;
                  border-right: 1px solid #23365d;
                  padding: 0 40px;
                "
              >
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td style="border-top: 1px solid #23365d; font-size: 1px; line-height: 1px">
                      &nbsp;
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- ===================== FOOTER ===================== -->
            <tr>
              <td
                style="
                  background-color: #0b1630;
                  border-radius: 0 0 16px 16px;
                  border: 1px solid #23365d;
                  border-top: none;
                  padding: 30px 40px 38px 40px;
                "
              >
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td align="center" style="padding-bottom: 6px">
                      <span
                        style="
                          font-family: Arial, Helvetica, sans-serif;
                          font-size: 14px;
                          font-weight: bold;
                          color: #c3cbd6;
                          letter-spacing: 0.5px;
                        "
                        >IBRAS Aviation</span
                      >
                    </td>
                  </tr>
                  <tr>
                    <td align="center" style="padding-bottom: 16px">
                      <span
                        style="
                          font-family: Arial, Helvetica, sans-serif;
                          font-size: 12px;
                          color: #8d99ac;
                          letter-spacing: 0.3px;
                        "
                        >Professional Flight Training</span
                      >
                    </td>
                  </tr>
                  <tr>
                    <td align="center">
                      <p
                        style="
                          margin: 0;
                          font-family: Arial, Helvetica, sans-serif;
                          font-size: 11px;
                          line-height: 18px;
                          color: #8d99ac;
                          max-width: 400px;
                        "
                      >
                        This email was automatically generated by the IBRAS Aviation website booking
                        system.
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>

          <!-- Bottom spacer -->
          <table
            role="presentation"
            width="620"
            cellpadding="0"
            cellspacing="0"
            border="0"
            style="width: 620px; max-width: 620px"
          >
            <tr>
              <td style="height: 24px; line-height: 24px; font-size: 1px">&nbsp;</td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
