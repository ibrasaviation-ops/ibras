<!DOCTYPE html>
<html
  lang="en"
  xmlns="http://www.w3.org/1999/xhtml"
  xmlns:v="urn:schemas-microsoft-com:vml"
  xmlns:o="urn:schemas-microsoft-com:office:office"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>New Discovery Flight Booking</title>
    <!--[if mso]>
      <noscript>
        <xml>
          <o:OfficeDocumentSettings>
            <o:PixelsPerInch>96</o:PixelsPerInch>
          </o:OfficeDocumentSettings>
        </xml>
      </noscript>
      <style>
        table {
          border-collapse: collapse;
        }
      </style>
    <![endif]-->
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f8fafc;
      -webkit-text-size-adjust: 100%;
      -ms-text-size-adjust: 100%;
    "
  >
    <!-- Preheader (hidden preview text) -->
    <div style="display: none; max-height: 0; overflow: hidden; opacity: 0; mso-hide: all">
      A customer has successfully booked a Discovery Flight through the IBRAS Aviation
      website.&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;
    </div>

    <table
      role="presentation"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      style="background-color: #f8fafc; width: 100%"
    >
      <tr>
        <td align="center" style="padding: 32px 16px">
          <table
            role="presentation"
            width="620"
            cellpadding="0"
            cellspacing="0"
            border="0"
            style="width: 620px; max-width: 620px"
          >
            <!-- ===================== HEADER ===================== -->
            <tr>
              <td
                style="
                  background-color: #ffffff;
                  border-radius: 16px 16px 0 0;
                  padding: 44px 40px 38px 40px;
                  border: 1px solid #e2e8f0;
                  border-bottom: none;
                "
              >
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td align="center" style="padding-bottom: 14px">
                      <span
                        style="
                          display: inline-block;
                          padding: 6px 16px;
                          border: 1px solid #1f4e9a;
                          border-radius: 20px;
                          font-family: Arial, Helvetica, sans-serif;
                          font-size: 11px;
                          letter-spacing: 2.5px;
                          color: #1f4e9a;
                          text-transform: uppercase;
                          font-weight: 600;
                        "
                        >IBRAS Aviation</span
                      >
                    </td>
                  </tr>
                  <tr>
                    <td align="center" style="padding-bottom: 8px">
                      <!-- Airplane SVG Icon -->
                      <svg
                        width="48"
                        height="48"
                        viewBox="0 0 24 24"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <path
                          d="M21 16V14L13 9V3.5C13 2.67 12.33 2 11.5 2S10 2.67 10 3.5V9L2 14V16L10 13.5V19L8 20.5V22L11.5 21L15 22V20.5L13 19V13.5L21 16Z"
                          fill="#1F4E9A"
                        />
                      </svg>
                    </td>
                  </tr>
                  <tr>
                    <td align="center">
                      <h1
                        style="
                          margin: 0;
                          font-family: Arial, Helvetica, sans-serif;
                          font-size: 26px;
                          line-height: 34px;
                          font-weight: bold;
                          color: #0f1f3d;
                          letter-spacing: 0.3px;
                        "
                      >
                        New Discovery Flight Booking
                      </h1>
                    </td>
                  </tr>
                  <tr>
                    <td align="center" style="padding-top: 12px">
                      <p
                        style="
                          margin: 0;
                          font-family: Arial, Helvetica, sans-serif;
                          font-size: 14px;
                          line-height: 22px;
                          color: #55657d;
                          max-width: 440px;
                        "
                      >
                        A customer has successfully booked a Discovery Flight through the IBRAS
                        Aviation website.
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- ===================== BODY WRAPPER ===================== -->
            <tr>
              <td
                style="
                  background-color: #ffffff;
                  border: 1px solid #e2e8f0;
                  border-top: none;
                  border-bottom: none;
                  padding: 36px 40px 8px 40px;
                "
              >
                <!-- ===================== BOOKING SUMMARY CARD ===================== -->
                <table
                  role="presentation"
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="
                    background-color: #f8fafc;
                    border: 1px solid #e2e8f0;
                    border-radius: 14px;
                    margin-bottom: 32px;
                  "
                >
                  <tr>
                    <td style="padding: 30px 30px 26px 30px">
                      <table
                        role="presentation"
                        width="100%"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                      >
                        <tr>
                          <td style="padding-bottom: 20px; border-bottom: 1px solid #e2e8f0">
                            <span
                              style="
                                display: block;
                                font-family: Arial, Helvetica, sans-serif;
                                font-size: 11px;
                                letter-spacing: 2px;
                                color: #94a3b8;
                                text-transform: uppercase;
                                font-weight: bold;
                                padding-bottom: 8px;
                              "
                              >Flight Booked</span
                            >
                            <span
                              style="
                                display: block;
                                font-family: Arial, Helvetica, sans-serif;
                                font-size: 23px;
                                line-height: 30px;
                                color: #0f1f3d;
                                font-weight: bold;
                              "
                              ><%= flightTitle %></span
                            >
                          </td>
                        </tr>
                        <tr>
                          <td style="padding-top: 20px">
                            <table
                              role="presentation"
                              width="100%"
                              cellpadding="0"
                              cellspacing="0"
                              border="0"
                            >
                              <tr>
                                <td valign="middle">
                                  <span
                                    style="
                                      display: block;
                                      font-family: Arial, Helvetica, sans-serif;
                                      font-size: 11px;
                                      letter-spacing: 2px;
                                      color: #94a3b8;
                                      text-transform: uppercase;
                                      font-weight: bold;
                                    "
                                    >Booking Total</span
                                  >
                                </td>
                                <td align="right" valign="middle">
                                  <span
                                    style="
                                      display: inline-block;
                                      font-family: Arial, Helvetica, sans-serif;
                                      font-size: 28px;
                                      line-height: 34px;
                                      color: #1f4e9a;
                                      font-weight: bold;
                                      letter-spacing: 0.3px;
                                    "
                                    >$<%= total.toFixed(2) %></span
                                  >
                                </td>
                              </tr>
                            </table>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>
                <!-- ===================== END BOOKING SUMMARY CARD ===================== -->

                <!-- Section label -->
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td style="padding-bottom: 16px">
                      <span
                        style="
                          font-family: Arial, Helvetica, sans-serif;
                          font-size: 11px;
                          letter-spacing: 2px;
                          color: #1f4e9a;
                          text-transform: uppercase;
                          font-weight: bold;
                        "
                        >Customer Information</span
                      >
                    </td>
                  </tr>
                </table>

                <!-- ===================== CUSTOMER INFO CARD ===================== -->
                <table
                  role="presentation"
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 14px"
                >
                  <tr>
                    <td style="padding: 6px 28px">
                      <!-- Row: First Name -->
                      <table
                        role="presentation"
                        width="100%"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                        style="border-bottom: 1px solid #e2e8f0"
                      >
                        <tr>
                          <td
                            width="42%"
                            style="
                              padding: 16px 12px 16px 0;
                              font-family: Arial, Helvetica, sans-serif;
                              font-size: 13px;
                              color: #94a3b8;
                              letter-spacing: 0.3px;
                              vertical-align: top;
                            "
                          >
                            First Name
                          </td>
                          <td
                            width="58%"
                            align="right"
                            style="
                              padding: 16px 0 16px 12px;
                              font-family: Arial, Helvetica, sans-serif;
                              font-size: 15px;
                              color: #0f1f3d;
                              font-weight: bold;
                              vertical-align: top;
                              text-align: right;
                            "
                          >
                            <%= customer.firstName %>
                          </td>
                        </tr>
                      </table>

                      <!-- Row: Last Name -->
                      <table
                        role="presentation"
                        width="100%"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                        style="border-bottom: 1px solid #e2e8f0"
                      >
                        <tr>
                          <td
                            width="42%"
                            style="
                              padding: 16px 12px 16px 0;
                              font-family: Arial, Helvetica, sans-serif;
                              font-size: 13px;
                              color: #94a3b8;
                              letter-spacing: 0.3px;
                              vertical-align: top;
                            "
                          >
                            Last Name
                          </td>
                          <td
                            width="58%"
                            align="right"
                            style="
                              padding: 16px 0 16px 12px;
                              font-family: Arial, Helvetica, sans-serif;
                              font-size: 15px;
                              color: #0f1f3d;
                              font-weight: bold;
                              vertical-align: top;
                              text-align: right;
                            "
                          >
                            <%= customer.lastName %>
                          </td>
                        </tr>
                      </table>

                      <!-- Row: Email -->
                      <table
                        role="presentation"
                        width="100%"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                        style="border-bottom: 1px solid #e2e8f0"
                      >
                        <tr>
                          <td
                            width="42%"
                            style="
                              padding: 16px 12px 16px 0;
                              font-family: Arial, Helvetica, sans-serif;
                              font-size: 13px;
                              color: #94a3b8;
                              letter-spacing: 0.3px;
                              vertical-align: top;
                            "
                          >
                            Email
                          </td>
                          <td
                            width="58%"
                            align="right"
                            style="
                              padding: 16px 0 16px 12px;
                              font-family: Arial, Helvetica, sans-serif;
                              font-size: 15px;
                              font-weight: bold;
                              vertical-align: top;
                              text-align: right;
                              word-break: break-all;
                            "
                          >
                            <a
                              href="mailto:<%= customer.email %>"
                              style="color: #1f4e9a; text-decoration: none"
                              ><%= customer.email %></a
                            >
                          </td>
                        </tr>
                      </table>

                      <!-- Row: Phone -->
                      <table
                        role="presentation"
                        width="100%"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                        style="border-bottom: 1px solid #e2e8f0"
                      >
                        <tr>
                          <td
                            width="42%"
                            style="
                              padding: 16px 12px 16px 0;
                              font-family: Arial, Helvetica, sans-serif;
                              font-size: 13px;
                              color: #94a3b8;
                              letter-spacing: 0.3px;
                              vertical-align: top;
                            "
                          >
                            Phone
                          </td>
                          <td
                            width="58%"
                            align="right"
                            style="
                              padding: 16px 0 16px 12px;
                              font-family: Arial, Helvetica, sans-serif;
                              font-size: 15px;
                              font-weight: bold;
                              vertical-align: top;
                              text-align: right;
                            "
                          >
                            <a
                              href="tel:<%= customer.phone %>"
                              style="color: #1f4e9a; text-decoration: none"
                              ><%= customer.phone %></a
                            >
                          </td>
                        </tr>
                      </table>

                      <!-- Row: Street Address -->
                      <table
                        role="presentation"
                        width="100%"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                        style="border-bottom: 1px solid #e2e8f0"
                      >
                        <tr>
                          <td
                            width="42%"
                            style="
                              padding: 16px 12px 16px 0;
                              font-family: Arial, Helvetica, sans-serif;
                              font-size: 13px;
                              color: #94a3b8;
                              letter-spacing: 0.3px;
                              vertical-align: top;
                            "
                          >
                            Street Address
                          </td>
                          <td
                            width="58%"
                            align="right"
                            style="
                              padding: 16px 0 16px 12px;
                              font-family: Arial, Helvetica, sans-serif;
                              font-size: 15px;
                              color: #0f1f3d;
                              font-weight: bold;
                              vertical-align: top;
                              text-align: right;
                            "
                          >
                            <%= customer.streetAddress %>
                          </td>
                        </tr>
                      </table>

                      <!-- Row: Apartment -->
                      <table
                        role="presentation"
                        width="100%"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                        style="border-bottom: 1px solid #e2e8f0"
                      >
                        <tr>
                          <td
                            width="42%"
                            style="
                              padding: 16px 12px 16px 0;
                              font-family: Arial, Helvetica, sans-serif;
                              font-size: 13px;
                              color: #94a3b8;
                              letter-spacing: 0.3px;
                              vertical-align: top;
                            "
                          >
                            Apartment
                          </td>
                          <td
                            width="58%"
                            align="right"
                            style="
                              padding: 16px 0 16px 12px;
                              font-family: Arial, Helvetica, sans-serif;
                              font-size: 15px;
                              color: #0f1f3d;
                              font-weight: bold;
                              vertical-align: top;
                              text-align: right;
                            "
                          >
                            <%= customer.apartment || "N/A" %>
                          </td>
                        </tr>
                      </table>

                      <!-- Row: City -->
                      <table
                        role="presentation"
                        width="100%"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                        style="border-bottom: 1px solid #e2e8f0"
                      >
                        <tr>
                          <td
                            width="42%"
                            style="
                              padding: 16px 12px 16px 0;
                              font-family: Arial, Helvetica, sans-serif;
                              font-size: 13px;
                              color: #94a3b8;
                              letter-spacing: 0.3px;
                              vertical-align: top;
                            "
                          >
                            City
                          </td>
                          <td
                            width="58%"
                            align="right"
                            style="
                              padding: 16px 0 16px 12px;
                              font-family: Arial, Helvetica, sans-serif;
                              font-size: 15px;
                              color: #0f1f3d;
                              font-weight: bold;
                              vertical-align: top;
                              text-align: right;
                            "
                          >
                            <%= customer.city %>
                          </td>
                        </tr>
                      </table>

                      <!-- Row: State -->
                      <table
                        role="presentation"
                        width="100%"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                        style="border-bottom: 1px solid #e2e8f0"
                      >
                        <tr>
                          <td
                            width="42%"
                            style="
                              padding: 16px 12px 16px 0;
                              font-family: Arial, Helvetica, sans-serif;
                              font-size: 13px;
                              color: #94a3b8;
                              letter-spacing: 0.3px;
                              vertical-align: top;
                            "
                          >
                            State
                          </td>
                          <td
                            width="58%"
                            align="right"
                            style="
                              padding: 16px 0 16px 12px;
                              font-family: Arial, Helvetica, sans-serif;
                              font-size: 15px;
                              color: #0f1f3d;
                              font-weight: bold;
                              vertical-align: top;
                              text-align: right;
                            "
                          >
                            <%= customer.state %>
                          </td>
                        </tr>
                      </table>

                      <!-- Row: ZIP Code -->
                      <table
                        role="presentation"
                        width="100%"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                      >
                        <tr>
                          <td
                            width="42%"
                            style="
                              padding: 16px 12px 16px 0;
                              font-family: Arial, Helvetica, sans-serif;
                              font-size: 13px;
                              color: #94a3b8;
                              letter-spacing: 0.3px;
                              vertical-align: top;
                            "
                          >
                            ZIP Code
                          </td>
                          <td
                            width="58%"
                            align="right"
                            style="
                              padding: 16px 0 16px 12px;
                              font-family: Arial, Helvetica, sans-serif;
                              font-size: 15px;
                              color: #0f1f3d;
                              font-weight: bold;
                              vertical-align: top;
                              text-align: right;
                            "
                          >
                            <%= customer.zipCode %>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>
                <!-- ===================== END CUSTOMER INFO CARD ===================== -->

                <!-- ===================== BOOKING ALERT BOX ===================== -->
                <table
                  role="presentation"
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="
                    margin-top: 28px;
                    background-color: #f8fafc;
                    border: 1px solid #1f4e9a;
                    border-left: 4px solid #1f4e9a;
                    border-radius: 12px;
                  "
                >
                  <tr>
                    <td style="padding: 22px 26px">
                      <table
                        role="presentation"
                        width="100%"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                      >
                        <tr>
                          <td style="padding-bottom: 8px">
                            <!-- Checkmark SVG -->
                            <svg
                              width="20"
                              height="20"
                              viewBox="0 0 24 24"
                              fill="none"
                              xmlns="http://www.w3.org/2000/svg"
                              style="
                                display: inline-block;
                                vertical-align: middle;
                                margin-right: 8px;
                              "
                            >
                              <path
                                d="M20 6L9 17L4 12"
                                stroke="#1F4E9A"
                                stroke-width="2.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                              />
                            </svg>
                            <span
                              style="
                                font-family: Arial, Helvetica, sans-serif;
                                font-size: 13px;
                                letter-spacing: 1.5px;
                                color: #0f1f3d;
                                text-transform: uppercase;
                                font-weight: bold;
                              "
                              >Booking Received</span
                            >
                          </td>
                        </tr>
                        <tr>
                          <td>
                            <p
                              style="
                                margin: 0;
                                font-family: Arial, Helvetica, sans-serif;
                                font-size: 14px;
                                line-height: 22px;
                                color: #55657d;
                              "
                            >
                              A new Discovery Flight purchase has been successfully completed.
                              Please verify the booking, review the customer information, and
                              contact the customer to schedule or confirm their flight if required.
                            </p>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>
                <!-- ===================== END BOOKING ALERT BOX ===================== -->

                <!-- ===================== ACTION BUTTON ===================== -->
                <table
                  role="presentation"
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="margin-top: 34px"
                >
                  <tr>
                    <td align="center">
                      <!--[if mso]>
                        <v:roundrect
                          xmlns:v="urn:schemas-microsoft-com:vml"
                          xmlns:w="urn:schemas-microsoft-com:office:word"
                          href="mailto:<%= customer.email %>"
                          style="height: 50px; v-text-anchor: middle; width: 280px"
                          arcsize="12%"
                          strokecolor="#1F4E9A"
                          fillcolor="#1F4E9A"
                        >
                          <w:anchorlock />
                          <center
                            style="
                              color: #ffffff;
                              font-family: Arial, sans-serif;
                              font-size: 15px;
                              font-weight: bold;
                            "
                          >
                            Reply to Customer
                          </center>
                        </v:roundrect>
                      <![endif]-->
                      <!--[if !mso]><!-->
                      <a
                        href="mailto:<%= customer.email %>"
                        style="
                          display: inline-block;
                          background-color: #1f4e9a;
                          color: #ffffff;
                          font-family: Arial, Helvetica, sans-serif;
                          font-size: 15px;
                          font-weight: bold;
                          text-decoration: none;
                          padding: 16px 44px;
                          border-radius: 10px;
                          letter-spacing: 0.3px;
                          border: 1px solid #1f4e9a;
                        "
                      >
                        Reply to Customer
                      </a>
                      <!--<![endif]-->
                    </td>
                  </tr>
                </table>
                <!-- ===================== END ACTION BUTTON ===================== -->

                <!-- Spacer -->
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td style="height: 36px; line-height: 36px; font-size: 1px">&nbsp;</td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- ===================== DIVIDER ===================== -->
            <tr>
              <td
                style="
                  background-color: #ffffff;
                  border-left: 1px solid #e2e8f0;
                  border-right: 1px solid #e2e8f0;
                  padding: 0 40px;
                "
              >
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td style="border-top: 1px solid #e2e8f0; font-size: 1px; line-height: 1px">
                      &nbsp;
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- ===================== FOOTER ===================== -->
            <tr>
              <td
                style="
                  background-color: #ffffff;
                  border-radius: 0 0 16px 16px;
                  border: 1px solid #e2e8f0;
                  border-top: none;
                  padding: 30px 40px 38px 40px;
                "
              >
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td align="center" style="padding-bottom: 6px">
                      <span
                        style="
                          font-family: Arial, Helvetica, sans-serif;
                          font-size: 14px;
                          font-weight: bold;
                          color: #0f1f3d;
                          letter-spacing: 0.5px;
                        "
                        >IBRAS Aviation</span
                      >
                    </td>
                  </tr>
                  <tr>
                    <td align="center" style="padding-bottom: 16px">
                      <span
                        style="
                          font-family: Arial, Helvetica, sans-serif;
                          font-size: 12px;
                          color: #94a3b8;
                          letter-spacing: 0.3px;
                        "
                        >Professional Flight Training</span
                      >
                    </td>
                  </tr>
                  <tr>
                    <td align="center">
                      <p
                        style="
                          margin: 0;
                          font-family: Arial, Helvetica, sans-serif;
                          font-size: 11px;
                          line-height: 18px;
                          color: #94a3b8;
                          max-width: 400px;
                        "
