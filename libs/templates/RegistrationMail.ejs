<!DOCTYPE html>
<html
  lang="en"
  xmlns="http://www.w3.org/1999/xhtml"
  xmlns:v="urn:schemas-microsoft-com:vml"
  xmlns:o="urn:schemas-microsoft-com:office:office"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>New Student Registration</title>
    <!--[if mso]>
      <noscript>
        <xml>
          <o:OfficeDocumentSettings>
            <o:PixelsPerInch>96</o:PixelsPerInch>
          </o:OfficeDocumentSettings>
        </xml>
      </noscript>
      <style>
        table {
          border-collapse: collapse;
        }
      </style>
    <![endif]-->
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #ffffff;
      -webkit-text-size-adjust: 100%;
      -ms-text-size-adjust: 100%;
    "
  >
    <!-- Preheader (hidden preview text) -->
    <div style="display: none; max-height: 0; overflow: hidden; opacity: 0; mso-hide: all">
      A new student has registered with IBRAS Aviation. Please review the details
      below.&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;
    </div>

    <table
      role="presentation"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      style="background-color: #ffffff; width: 100%"
    >
      <tr>
        <td align="center" style="padding: 32px 16px">
          <table
            role="presentation"
            width="600"
            cellpadding="0"
            cellspacing="0"
            border="0"
            style="width: 600px; max-width: 600px"
          >
            <!-- ===================== HEADER ===================== -->
            <tr>
              <td
                style="
                  background-color: #ffffff;
                  border-radius: 8px 8px 0 0;
                  padding: 28px 30px 22px 30px;
                  text-align: center;
                  border: 1px solid #e2e6ed;
                  border-bottom: 3px solid #133a7c;
                "
              >
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td align="center">
                      <table
                        role="presentation"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                        style="margin: 0 auto"
                      >
                        <tr>
                          <!--[if !mso]><!-->
                          <td style="padding-right: 9px; vertical-align: middle">
                            <svg
                              width="24"
                              height="24"
                              viewBox="0 0 24 24"
                              fill="none"
                              xmlns="http://www.w3.org/2000/svg"
                              style="display: block"
                            >
                              <path
                                d="M21 16v-2l-8-5V3.5a1.5 1.5 0 0 0-3 0V9l-8 5v2l8-2.5V19l-2.5 1.5V22l4-1 4 1v-1.5L13 19v-5.5l8 2.5z"
                                fill="#0F1F3D"
                              />
                            </svg>
                          </td>
                          <!--<![endif]-->
                          <td style="vertical-align: middle">
                            <h1
                              style="
                                margin: 0;
                                font-family: Arial, Helvetica, sans-serif;
                                font-size: 22px;
                                line-height: 26px;
                                color: #0f1f3d;
                                letter-spacing: 0.5px;
                                font-weight: bold;
                              "
                            >
                              IBRAS Aviation
                            </h1>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                  <tr>
                    <td align="center" style="padding-top: 6px">
                      <p
                        style="
                          margin: 0;
                          font-family: Arial, Helvetica, sans-serif;
                          font-size: 13px;
                          color: #55657d;
                          text-transform: uppercase;
                          letter-spacing: 1px;
                        "
                      >
                        New Student Registration
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- ===================== BODY WRAPPER ===================== -->
            <tr>
              <td
                style="
                  background-color: #ffffff;
                  border: 1px solid #e2e6ed;
                  border-top: none;
                  border-bottom: none;
                  padding: 30px;
                "
              >
                <!-- Greeting -->
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td
                      style="
                        font-family: Arial, Helvetica, sans-serif;
                        font-size: 18px;
                        font-weight: bold;
                        color: #0f1f3d;
                        padding-bottom: 5px;
                      "
                    >
                      Hello Admin,
                    </td>
                  </tr>
                  <tr>
                    <td
                      style="
                        font-family: Arial, Helvetica, sans-serif;
                        font-size: 14px;
                        line-height: 21px;
                        color: #55657d;
                        padding-bottom: 22px;
                      "
                    >
                      A new student has registered. Please review the details below.
                    </td>
                  </tr>
                </table>

                <!-- ===================== INFO BOX ===================== -->
                <table
                  role="presentation"
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="
                    background-color: #ffffff;
                    border: 1px solid #e2e6ed;
                    border-left: 4px solid #133a7c;
                    border-radius: 8px;
                    margin: 18px 0;
                  "
                >
                  <tr>
                    <td style="padding: 2px 20px">
                      <!-- Row: Full Name -->
                      <table
                        role="presentation"
                        width="100%"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                        style="border-bottom: 1px solid #eef1f5"
                      >
                        <tr>
                          <td
                            width="40%"
                            style="
                              padding: 12px 8px 12px 0;
                              font-family: Arial, Helvetica, sans-serif;
                              font-size: 13px;
                              font-weight: bold;
                              color: #55657d;
                              vertical-align: middle;
                            "
                          >
                            <!--[if !mso]><!-->
                            <svg
                              width="16"
                              height="16"
                              viewBox="0 0 24 24"
                              fill="none"
                              xmlns="http://www.w3.org/2000/svg"
                              style="vertical-align: -3px; margin-right: 7px"
                            >
                              <path
                                d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z"
                                stroke="#A5AFBD"
                                stroke-width="1.8"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                              />
                            </svg>
                            <!--<![endif]-->
                            Full Name
                          </td>
                          <td
                            width="60%"
                            style="
                              padding: 12px 0 12px 8px;
                              font-family: Arial, Helvetica, sans-serif;
                              font-size: 14px;
                              color: #0f1f3d;
                              font-weight: bold;
                              vertical-align: middle;
                            "
                          >
                            <%= firstName %> <%= lastName %>
                          </td>
                        </tr>
                      </table>

                      <!-- Row: Email -->
                      <table
                        role="presentation"
                        width="100%"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                        style="border-bottom: 1px solid #eef1f5"
                      >
                        <tr>
                          <td
                            width="40%"
                            style="
                              padding: 12px 8px 12px 0;
                              font-family: Arial, Helvetica, sans-serif;
                              font-size: 13px;
                              font-weight: bold;
                              color: #55657d;
                              vertical-align: middle;
                            "
                          >
                            <!--[if !mso]><!-->
                            <svg
                              width="16"
                              height="16"
                              viewBox="0 0 24 24"
                              fill="none"
                              xmlns="http://www.w3.org/2000/svg"
                              style="vertical-align: -3px; margin-right: 7px"
                            >
                              <path
                                d="M4 4h16v16H4V4Z M4 6l8 7 8-7"
                                stroke="#A5AFBD"
                                stroke-width="1.8"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                              />
                            </svg>
                            <!--<![endif]-->
                            Email
                          </td>
                          <td
                            width="60%"
                            style="
                              padding: 12px 0 12px 8px;
                              font-family: Arial, Helvetica, sans-serif;
                              font-size: 14px;
                              color: #0f1f3d;
                              vertical-align: middle;
                              word-break: break-all;
                            "
                          >
                            <a
                              href="mailto:<%= email %>"
                              style="color: #0f1f3d; text-decoration: underline"
                              ><%= email %></a
                            >
                          </td>
                        </tr>
                      </table>

                      <!-- Row: Phone -->
                      <table
                        role="presentation"
                        width="100%"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                        style="border-bottom: 1px solid #eef1f5"
                      >
                        <tr>
                          <td
                            width="40%"
                            style="
                              padding: 12px 8px 12px 0;
                              font-family: Arial, Helvetica, sans-serif;
                              font-size: 13px;
                              font-weight: bold;
                              color: #55657d;
                              vertical-align: middle;
                            "
                          >
                            <!--[if !mso]><!-->
                            <svg
                              width="16"
                              height="16"
                              viewBox="0 0 24 24"
                              fill="none"
                              xmlns="http://www.w3.org/2000/svg"
                              style="vertical-align: -3px; margin-right: 7px"
                            >
                              <path
                                d="M6.6 10.8a15.9 15.9 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25c1.1.36 2.3.56 3.5.56a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.6 21 3 13.4 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.2.2 2.4.56 3.5a1 1 0 0 1-.25 1L6.6 10.8Z"
                                stroke="#A5AFBD"
                                stroke-width="1.8"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                              />
                            </svg>
                            <!--<![endif]-->
                            Phone
                          </td>
                          <td
                            width="60%"
                            style="
                              padding: 12px 0 12px 8px;
                              font-family: Arial, Helvetica, sans-serif;
                              font-size: 14px;
                              color: #0f1f3d;
                              vertical-align: middle;
                            "
                          >
                            <a href="tel:<%= phone %>" style="color: #0f1f3d; text-decoration: none"
                              ><%= phone %></a
                            >
                          </td>
                        </tr>
                      </table>

                      <!-- Row: Course -->
                      <table
                        role="presentation"
                        width="100%"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                      >
                        <tr>
                          <td
                            width="40%"
                            style="
                              padding: 12px 8px 12px 0;
                              font-family: Arial, Helvetica, sans-serif;
                              font-size: 13px;
                              font-weight: bold;
                              color: #55657d;
                              vertical-align: middle;
                            "
                          >
                            <!--[if !mso]><!-->
                            <svg
                              width="16"
                              height="16"
                              viewBox="0 0 24 24"
                              fill="none"
                              xmlns="http://www.w3.org/2000/svg"
                              style="vertical-align: -3px; margin-right: 7px"
                            >
                              <path
                                d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20 M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"
                                stroke="#A5AFBD"
                                stroke-width="1.8"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                              />
                            </svg>
                            <!--<![endif]-->
                            Course
                          </td>
                          <td
                            width="60%"
                            style="
                              padding: 12px 0 12px 8px;
                              font-family: Arial, Helvetica, sans-serif;
                              font-size: 14px;
                              color: #5d84d6;
                              font-weight: bold;
                              vertical-align: middle;
                            "
                          >
                            <%= course %>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>
                <!-- ===================== END INFO BOX ===================== -->

                <!-- ===================== AUTH BOX ===================== -->
                <table
                  role="presentation"
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="
                    background-color: #f7f9fc;
                    border: 1px solid #e2e6ed;
                    border-radius: 8px;
                    margin: 18px 0;
                  "
                >
                  <tr>
                    <td style="padding: 15px 18px">
                      <table
                        role="presentation"
                        width="100%"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                      >
                        <tr>
                          <td
                            style="
                              padding-bottom: 6px;
                              font-family: Arial, Helvetica, sans-serif;
                              font-size: 12px;
                              font-weight: bold;
                              color: #55657d;
                              text-transform: uppercase;
                              letter-spacing: 0.5px;
                            "
                          >
                            <!--[if !mso]><!-->
                            <svg
                              width="15"
                              height="15"
                              viewBox="0 0 24 24"
                              fill="none"
                              xmlns="http://www.w3.org/2000/svg"
                              style="vertical-align: -3px; margin-right: 7px"
                            >
                              <path
                                d="M9 12h6m-6 4h6M9 8h1M7 3h10a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z"
                                stroke="#A5AFBD"
                                stroke-width="1.8"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                              />
                            </svg>
                            <!--<![endif]-->
                            Authorization Status
                          </td>
                        </tr>
                        <tr>
                          <td
                            style="
                              font-family: Arial, Helvetica, sans-serif;
                              font-size: 14px;
                              color: #0f1f3d;
                              padding-left: 24px;
                            "
                          >
                            <%= authorization %>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>
                <!-- ===================== END AUTH BOX ===================== -->

                <!-- ===================== ACTION BOX ===================== -->
                <table
                  role="presentation"
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="
                    background-color: #f7f9fc;
                    border: 1px solid #e2e6ed;
                    border-left: 4px solid #1f4e9a;
                    border-radius: 8px;
                    margin: 18px 0;
                  "
                >
                  <tr>
                    <td style="padding: 15px 18px">
                      <table
                        role="presentation"
                        width="100%"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                      >
                        <tr>
                          <!--[if !mso]><!-->
                          <td
                            width="24"
                            style="vertical-align: top; padding-top: 2px; padding-right: 10px"
                          >
                            <svg
                              width="18"
                              height="18"
                              viewBox="0 0 24 24"
                              fill="none"
                              xmlns="http://www.w3.org/2000/svg"
                              style="display: block"
                            >
                              <path
                                d="M12 9v4m0 4h.01M10.3 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.7 3.86a2 2 0 0 0-3.4 0Z"
                                stroke="#1F4E9A"
                                stroke-width="1.8"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                              />
                            </svg>
                          </td>
                          <!--<![endif]-->
                          <td
                            style="
                              font-family: Arial, Helvetica, sans-serif;
                              font-size: 14px;
                              line-height: 21px;
                              color: #0f1f3d;
                              vertical-align: top;
                            "
                          >
                            <strong>Action Required:</strong> Please follow up with this student at
                            your earliest convenience.
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>
                <!-- ===================== END ACTION BOX ===================== -->

                <!-- ===================== META BOX ===================== -->
                <table
                  role="presentation"
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="
                    background-color: #ffffff;
                    border: 1px solid #e2e6ed;
                    border-radius: 8px;
                    margin: 18px 0;
                  "
                >
                  <tr>
                    <td
                      style="
                        padding: 12px 16px;
                        font-family: Arial, Helvetica, sans-serif;
                        font-size: 13px;
                        color: #55657d;
                      "
                    >
                      <strong style="color: #0f1f3d">Student ID:</strong> #<%= studentId %>
                    </td>
                  </tr>
                </table>
                <!-- ===================== END META BOX ===================== -->

                <!-- ===================== NEXT STEPS ===================== -->
                <table
                  role="presentation"
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="margin-top: 22px"
                >
                  <tr>
                    <td
                      style="
                        font-family: Arial, Helvetica, sans-serif;
                        font-size: 13px;
                        font-weight: bold;
                        color: #55657d;
                        padding-bottom: 10px;
                      "
                    >
                      Next Steps
                    </td>
                  </tr>
                  <tr>
                    <td>
                      <table
                        role="presentation"
                        width="100%"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                      >
                        <tr>
                          <!--[if !mso]><!-->
                          <td width="20" style="vertical-align: top; padding: 6px 8px 6px 0">
                            <svg
                              width="14"
                              height="14"
                              viewBox="0 0 24 24"
                              fill="none"
                              xmlns="http://www.w3.org/2000/svg"
                              style="display: block; margin-top: 3px"
                            >
                              <path
                                d="M5 12l4 4L19 6"
                                stroke="#A5AFBD"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                              />
                            </svg>
                          </td>
                          <!--<![endif]-->
                          <td
                            style="
                              font-family: Arial, Helvetica, sans-serif;
                              font-size: 13px;
                              color: #55657d;
                              padding: 6px 0;
                            "
                          >
                            Verify student contact information
                          </td>
                        </tr>
                        <tr>
                          <!--[if !mso]><!-->
                          <td width="20" style="vertical-align: top; padding: 6px 8px 6px 0">
                            <svg
                              width="14"
                              height="14"
                              viewBox="0 0 24 24"
                              fill="none"
                              xmlns="http://www.w3.org/2000/svg"
                              style="display: block; margin-top: 3px"
                            >
                              <path
                                d="M5 12l4 4L19 6"
                                stroke="#A5AFBD"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                              />
                            </svg>
                          </td>
                          <!--<![endif]-->
                          <td
                            style="
                              font-family: Arial, Helvetica, sans-serif;
                              font-size: 13px;
                              color: #55657d;
                              padding: 6px 0;
                            "
                          >
                            Send confirmation email to student
                          </td>
                        </tr>
                        <tr>
                          <!--[if !mso]><!-->
                          <td width="20" style="vertical-align: top; padding: 6px 8px 6px 0">
                            <svg
                              width="14"
                              height="14"
                              viewBox="0 0 24 24"
                              fill="none"
                              xmlns="http://www.w3.org/2000/svg"
                              style="display: block; margin-top: 3px"
                            >
                              <path
                                d="M5 12l4 4L19 6"
                                stroke="#A5AFBD"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                              />
                            </svg>
                          </td>
                          <!--<![endif]-->
                          <td
                            style="
                              font-family: Arial, Helvetica, sans-serif;
                              font-size: 13px;
                              color: #55657d;
                              padding: 6px 0;
                            "
                          >
                            Schedule orientation if applicable
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>
                <!-- ===================== END NEXT STEPS ===================== -->

                <!-- Submitted -->
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td
                      style="
                        font-family: Arial, Helvetica, sans-serif;
                        font-size: 13px;
                        color: #94a3b8;
                        padding-top: 22px;
                        padding-bottom: 8px;
                      "
                    >
                      Submitted on: <%= submissionDate %>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- ===================== FOOTER ===================== -->
            <tr>
              <td
                style="
                  background-color: #ffffff;
                  border-radius: 0 0 8px 8px;
                  border: 1px solid #e2e6ed;
                  border-top: 1px solid #e2e6ed;
                  padding: 22px 20px;
                  text-align: center;
                "
              >
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td
                      align="center"
                      style="
                        font-family: Arial, Helvetica, sans-serif;
                        font-size: 12px;
                        color: #94a3b8;
                        padding-bottom: 4px;
                      "
                    >
                      &copy; 2026
                      <span style="color: #0f1f3d; font-weight: bold">IBRAS Aviation</span> &mdash;
                      All rights reserved.
                    </td>
                  </tr>
                  <tr>
                    <td
                      align="center"
                      style="
                        font-family: Arial, Helvetica, sans-serif;
                        font-size: 12px;
                        color: #94a3b8;
                      "
                    >
                      This is an automated notification. Please do not reply to this email.
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>

          <!-- Bottom spacer -->
          <table
            role="presentation"
            width="600"
            cellpadding="0"
            cellspacing="0"
            border="0"
            style="width: 600px; max-width: 600px"
          >
            <tr>
              <td style="height: 24px; line-height: 24px; font-size: 1px">&nbsp;</td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
